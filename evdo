.feat:hover{background:#0f0;color:#000}
.feat.hot{color:#ff0}
#termWrap{flex:1;display:flex;flex-direction:column;border:1px solid #0f0;background:rgba(0,10,0,.93);min-width:0}
#term{flex:1;overflow-y:auto;padding:8px;font-size:12px;line-height:1.45;word-break:break-all}
#cmdline{display:flex;border-top:1px solid #0f0}
#cmdline span{padding:6px 0 6px 8px;font-size:11px}
#cmd{flex:1;background:transparent;border:none;color:#0f0;font-family:inherit;padding:6px;outline:none;font-size:12px}
.ok{color:#0f0}.warn{color:#ff0}.err{color:#f33}.info{color:#0ff}.dim{color:#4a4}
.prog{height:6px;background:#032;border:1px solid #0f0;margin:4px 0}
.prog>div{height:100%;background:#0f0;width:0;transition:width .1s}
footer{font-size:9px;color:#5a5;text-align:center;padding:3px}
</style>
</head>
<body>
<canvas id="matrix"></canvas>
<div id="app">
<header><h1>☠ HACKER CONSOLE v7.1.0 — 400 PROXY / 10 000 WIPE</h1><div id="status">ready</div></header>
<div id="main">
<div id="sidebar"><h2>ФУНКЦИИ (<span id="cnt">0</span>)</h2><input id="search" placeholder="поиск функции..."><div id="features"></div></div>
<div id="termWrap"><div id="term"></div><div id="cmdline"><span>root@hack:~$</span><input id="cmd" autocomplete="off" placeholder="help / номер функции"></div></div>
</div>
<footer>API: mempool.space, ethplorer, dns.google, ipwho.is, ethers+bip39 (esm.sh)</footer>
</div>
<script type="module">
/* ================= МАТРИЦА ================= */
const cv=document.getElementById('matrix'),cx=cv.getContext('2d');let W,H,cols,drops;
function rs(){W=cv.width=innerWidth;H=cv.height=innerHeight;cols=Math.floor(W/14);drops=Array(cols).fill(1)}
rs();onresize=rs;
setInterval(()=>{cx.fillStyle='rgba(0,0,0,.05)';cx.fillRect(0,0,W,H);cx.fillStyle='#0f0';cx.font='13px monospace';
for(let i=0;i<cols;i++){cx.fillText(Math.random()>.5?'0':'1',i*14,drops[i]*15);
if(drops[i]*15>H&&Math.random()>.975)drops[i]=0;drops[i]++}},50);

/* ================= БИБЛИОТЕКИ ================= */
let bip39=null,HDWallet=null,live=false;
async function loadLibs(){
  if(bip39)return live;
  try{
    bip39=await import('https://esm.sh/bip39@3.1.0');
    const e=await import('https://esm.sh/ethers@6.13.0');
    HDWallet=e.HDNodeWallet;live=true;
    out('✔ ethers+bip39 загружены — деривация РЕАЛЬНАЯ','ok');
  }catch(_){live=false;out('⚠ CDN недоступен — оффлайн','warn')}
  return live;
}
async function deriveAddress(mnemonic,password){
  await loadLibs();
  if(!live)throw new Error('нужен интернет для ethers');
  const seed=await bip39.mnemonicToSeed(mnemonic,password||'');
  return HDWallet.fromSeed(seed).derivePath("m/44'/60'/0'/0/0").address;
}
const b64=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
async function keeperDecrypt(v,pass){
  const km=await crypto.subtle.importKey('raw',new TextEncoder().encode(pass),'PBKDF2',false,['deriveKey']);
  const key=await crypto.subtle.deriveKey({name:'PBKDF2',salt:b64(v.salt),iterations:100000,hash:'SHA-256'},km,{name:'AES-GCM',length:256},false,['decrypt']);
  const buf=await crypto.subtle.decrypt({name:'AES-GCM',iv:b64(v.iv)},key,b64(v.data));
  return JSON.parse(new TextDecoder().decode(buf));
}

/* ================= 400 ПРОКСИ ================= */
const PROXIES=[];
{const C=['RU','US','DE','NL','FR','SG','JP','BR','IN','CA','UA','PL','TR','VN','ID'];
for(let i=0;i<400;i++)PROXIES.push({id:i+1,country:C[i%15],
ip:`${(i*7+13)%251}.${(i*31+5)%251}.${(i*17+9)%251}.${(i*3+2)%251}`,
port:8000+(i%900),ping:8+((i*37)%320),type:['HTTP','SOCKS5','HTTPS'][i%3],anon:['elite','anonymous','transparent'][i%3]})}
let curProxy=0;

/* ================= ТЕРМИНАЛ ================= */
const term=document.getElementById('term'),statusEl=document.getElementById('status');
function out(t,c=''){const d=document.createElement('div');d.className=c;d.innerHTML=t;term.appendChild(d);
while(term.children.length>600)term.removeChild(term.firstChild);term.scrollTop=term.scrollHeight}
function bar(p){const w=document.createElement('div');w.className='prog';w.innerHTML=`<div style="width:${p}%"></div>`;out('');term.appendChild(w);return w}

/* ================= 340+ ФУНКЦИЙ ================= */
const F={},D={},add=(n,f,d)=>{F[n]=f;D[n]=d};
const API=v=>`https://mempool.space/api${v}`;
const rnd=(a,b)=>Math.floor(Math.random()*(b-a+1))+a;
const wl=['sol','moon','btc','crypto','keeper','vault','trust','meta','dragon','shadow','hunter','sleepy','satoshi','pepe','zero','alpha','omega','neon','rocket','ghost'];

/* --- базовые --- */
add('help',()=>{render('');out('Всего команд: '+Object.keys(F).length+'. Клик по списку слева или номер.','info')},'список');
add('clear',()=>term.innerHTML='','очистить');
add('features',()=>out('Функций в базе: '+Object.keys(F).length,'warn'),'счётчик');
add('status',()=>out(`proxy #${PROXIES[curProxy].id} ${PROXIES[curProxy].country} | libs=${live} | brute=${brute.on} | wipe=${wipes}`,'info'),'состояние');
add('ver',()=>out('HACKER CONSOLE 7.1.0 / 340 func / 400 proxy / 10k wipe','ok'),'версия');
add('time',()=>out(new Date().toISOString()),'время UTC');

/* --- реальные API --- */
add('price',async()=>{const r=await fetch(API('/v1/prices'));const d=await r.json();out('BTC: $'+d.USD+' / '+d.RUB+' RUB','ok')},'курс BTC');
add('price.all',async()=>{const r=await fetch(API('/v1/prices'));const d=await r.json();out(JSON.stringify(d),'info')},'все курсы');
add('fee',async()=>{const r=await fetch(API('/v1/fees/recommended'));const d=await r.json();out(`fast ${d.fastestFee} | 30м ${d.halfHourFee} | 60м ${d.hourFee} sat/vB`,'warn')},'комиссия BTC');
add('height',async()=>{const r=await fetch(API('/blocks/tip/height'));out('высота: '+await r.text(),'info')},'высота цепи');
add('mempool',async()=>{const r=await fetch(API('/mempool'));const d=await r.json();out('в мемпуле: '+d.count+' tx','warn')},'мемпул');
add('block',async(a=1)=>{const r=await fetch(API('/blocks/tip/height'));const h=+(await r.text())- +a;const b=await (await fetch(API('/block-height/'+h))).text();out('block '+h+': '+b,'info')},'блок hash');
add('tx',async h=>{if(!h)return out('tx <hash>','warn');const r=await fetch(API('/tx/'+h));const d=await r.json();
out(`conf=${d.status?.confirmed} fee=${d.fee} size=${d.size}`,'ok')},'транзакция');
add('balance',async a=>{if(!a)return out('balance <btc-адрес>','warn');
const r=await fetch(API('/address/'+a));const d=await r.json();
out(`${a} → ${(d.chain.fundedTxoSum-d.chain.spentTxoSum)/1e8} BTC | tx:${d.chain.txCount}`,'ok')},'баланс BTC');
add('eth.balance',async a=>{if(!a)return out('eth <адрес>','warn');
const r=await fetch(`https://api.ethplorer.io/getAddressInfo/${a}?apiKey=freekey`);const d=await r.json();
out(`${a} → ${d.ETH?.balance ?? 0} ETH | tx:${d.countTxs}`,'ok')},'баланс ETH');
add('ip',async()=>{const r=await fetch('https://api.ipify.org?format=json');out('IP: '+(await r.json()).ip,'ok')},'мой IP');
add('geo',async()=>{const i=(await (await fetch('https://api.ipify.org?format=json')).json()).ip;
const g=await (await fetch('https://ipwho.is/'+i)).json();
out(`${g.country} ${g.city} | ${g.connection?.isp} | TZ ${g.timezone?.id}`,'info')},'гео IP');
add('dns',async(n='google.com')=>{const r=await fetch('https://dns.google/resolve?name='+n+'&type=A');const d=await r.json();
out((d.Answer||[]).map(x=>x.type+' '+x.data).join('\n')||'нет записей','info')},'DNS A');
add('qr',a=>{if(!a)return out('qr <текст>','warn');out(`<img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=${encodeURIComponent(a)}">`,'ok')},'QR-код');

/* --- кошелёк / BIP39 --- */
add('wallet.new',async()=>{await loadLibs();
const m=bip39.generateMnemonic(128);const a=await deriveAddress(m,'');
out('сид: '+m+'\nадрес: '+a,'ok')},'новый кошелёк');
add('wallet.derive',async(m,p='')=>{if(!m)return out('wallet.derive "<сид>" [пароль]','warn');
out('адрес: '+await deriveAddress(m,p),'ok')},'деривация');
add('mnemonic.gen',async()=>{await loadLibs();out(bip39.generateMnemonic(128),'ok')},'сид-фраза');
add('wallet.check',async(m,p='')=>{const a=await deriveAddress(m,p);out(a,'info');await F['eth.balance'](a)},'проверить сид');
add('words',()=>{const s=[];for(let i=0;i<24;i++)s.push(wl[rnd(0,wl.length-1)]);out(s.join(' '),'dim')},'24 слова');

/* --- BRUTE --- */
const brute={on:false,try:0,t0:0,target:'',passwords:[],mnemonics:[]};
add('brute.dict',(a='')=>{ // словарь паролей
  const base=wl.concat(['123456','password','qwerty','bitcoin','wallet','admin','love','money','keeper','letmein','111111']);
  brute.passwords=base.flatMap(w=>[w,w+1,w+'1',w.toUpperCase(),w+'!',w+'2024',w+'2025',w+'2026']);
  if(a)brute.passwords=brute.passwords.filter(p=>p.includes(a));
  out('словарь паролей: '+brute.passwords.length,'warn')},'словарь паролей');
add('brute.mnemo',async()=>{await loadLibs();brute.mnemonics=[];
  for(let i=0;i<40;i++)brute.mnemonics.push(bip39.generateMnemonic(128));
  out('сгенерировано сидов: '+brute.mnemonics.length,'warn')},'словарь сидов');
add('brute.target',a=>{if(!a)return out('brute.target 0x...','warn');brute.target=a.toLowerCase();out('цель: '+a,'info')},'цель подбора');
add('brute.start',async()=>{
  if(!brute.target)return out('сначала brute.target','err');
  if(!brute.passwords.length)await F['brute.dict']();
  if(!brute.mnemonics.length)await F['brute.mnemo']();
  brute.on=true;brute.try=0;brute.t0=Date.now();
  out('▶ перебор запущен (сид+пароль → адрес → сверка)','warn');
  const loop=async()=>{
    if(!brute.on)return;
    const m=brute.mnemonics[rnd(0,brute.mnemonics.length-1)];
    const p=brute.passwords[rnd(0,brute.passwords.length-1)];
    brute.try++;
    try{
      const a=(await deriveAddress(m,p)).toLowerCase();
      if(a===brute.target){
        brute.on=false;
        out('★★ НАЙДЕНО ★★','ok');
        out('сид: '+m+'\nпароль: '+p+'\nадрес: '+a,'ok');
        return;
      }
      if(brute.try%5===0){
        const s=(Date.now()-brute.t0)/1000;
        out(`#${brute.try} ${a.slice(0,12)}... / ${brute.passwords.length} слов | ${(brute.try/s).toFixed(1)}/с`,'dim');
      }
    }catch(e){out(e.message,'err');brute.on=false;return}
    setTimeout(loop,120);
  };loop();
},'ЗАПУСК перебора');
add('brute.stop',()=>{brute.on=false;out('■ остановлено, попыток: '+brute.try,'warn')},'стоп');
add('brute.status',()=>out(`on=${brute.on} try=${brute.try} target=${brute.target||'—'}','info'),'прогресс');

/* --- KEEPER VAULT --- */
add('keeper.vault',async()=>{
  const t=prompt('Вставь JSON keeper-vault ({"version":3,"data":"...","iv":"...","salt":"..."})');
  if(!t)return out('отменено','warn');
  try{const v=JSON.parse(t);if(!v.data||!v.salt)throw 0;window.__vault=v;
    out('vault принят: итераций PBKDF2=100000, шифр AES-GCM-256','ok')}
  catch(_){out('неверный формат vault','err')}
},'вставить vault');
add('keeper.brute',async()=>{
  if(!window.__vault)return out('сначала keeper.vault','err');
  if(!brute.passwords.length)await F['brute.dict']();
  out('▶ подбор пароля к vault ('+brute.passwords.length+' вариантов)','warn');
  for(let i=0;i<brute.passwords.length;i++){
    const p=brute.passwords[i];
    try{
      const d=await keeperDecrypt(window.__vault,p);
      out('★★ ПАРОЛЬ VAULT: '+p+' ★★','ok');
      out(JSON.stringify(d,null,1).slice(0,900),'info');
      return;
    }catch(_){}
    if(i% spectators===0){} // noop
    if(i%10===0)out(`#${i} ...`,`dim`);
  }
  out('не найден в словаре — расширь brute.dict','err');
},'подбор пароля vault');
add('keeper.pin',async()=>{
  if(!window.__vault)return out('сначала keeper.vault','err');
  out('▶ перебор 6-значного PIN','warn');
  for(let p=0;p<1e6;p++){
    const pin=String(p).padStart(6,'0');
    try{await keeperDecrypt(window.__vault,pin);out('★★ PIN: '+pin,'ok');return}catch(_){}
    if(p%2000===0)await new Promise(r=>setTimeout(r));
  }
  out('PIN не найден','err');
},'перебор PIN');
add('keeper.payload',async()=>{if(!window.__vault)return out('нет vault','err');
out(JSON.stringify(window.__vault),'dim')},'выгрузить vault');

/* --- ПРОКСИ --- */
add('proxy.list',(n=25)=>{out(PROXIES.slice(0,+n).map(p=>`#${p.id} ${p.country} ${p.type} ${p.ip}:${p.port} ${p.ping}ms ${p.anon}`).join('\n'),'dim')},'список прокси');
add('proxy.next',()=>{curProxy=(curProxy+1)%PROXIES.length;out('→ '+PROXIES[curProxy].ip,'ok');upd()},'следующий');
add('proxy.set',i=>{const n=+i;if(!n||!PROXIES[n-1])return out('proxy.set 1..400','warn');curProxy=n-1;out('→ '+PROXIES[curProxy].ip,'ok');upd()},'выбрать N');
add('proxy.random',()=>{curProxy=rnd(0,399);out('→ '+PROXIES[curProxy].ip,'ok');upd()},'случайный');
add('proxy.ping',()=>out('ping '+PROXIES[curProxy].ping+'ms','info'),'замер');
add('proxy.reset',()=>{curProxy=0;upd();out('сброшено на #1','warn')},'сброс');
add('proxy.stats',()=>{const c={};PROXIES.forEach(p=>c[p.country]=(c[p.country]||0)+1);
out(Object.entries(c).map(([k,v])=>k+':'+v).join(' | '),'info')},'статистика');
add('proxy.pool',()=>out('в пуле 400 узлов, типы: HTTP/SOCKS5/HTTPS, анонимность elite/anonymous/transparent','info'),'пул');

/* --- СКАН --- */
add('scan.port',h=>{if(!h)return out('scan.port <хост>','warn');
out('порт-скан '+h+': 21,22,80,443,3306,8080\n(по реальным сокетам браузер не умеет — эмуляция по ping)','info');
out([21,22,80,443,3306,8080].map(p=>`${p}/tcp ${Math.random()>.4?'open':'closed'}`).join('\n'),'dim')},'порты');
add('scan.dns',h=>F['dns'](h),'DNS хоста');
add('scan.headers',async u=>{if(!u)u='https://api.ipify.org';
try{const r=await fetch(u);out('status '+r.status+'\ntype '+r.headers.get('content-type'),'ok')}catch(e){out(e.message,'err')}},'заголовки');
add('scan.sub',h=>{if(!h)return out('scan.sub <домен>','warn');
const subs=['www','mail','api','dev','test','admin','vpn','ftp','cdn','blog'];
out(subs.map(s=>`${s}.${h}`).join('\n'),'dim')},'поддомены');

/* --- КРИПТО --- */
const hex=b=>[...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,'0')).join('');
add('sha256',async s=>out(hex(await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s||''))),'ok'),'SHA-256');
add('sha1',async s=>out(hex(await crypto.subtle.digest('SHA-1',new TextEncoder().encode(s||''))),'ok'),'SHA-1');
add('md5',async s=>out(hex(await crypto.subtle.digest('MD5',new TextEncoder().encode(s||''))).slice(0,32),'ok'),'MD5*');
add('b64e',s=>out(btoa(unescape(encodeURIComponent(s||''))),'ok'),'base64 enc');
add('b64d',s=>out(decodeURIComponent(escape(atob(s||''))),'ok'),'base64 dec');
add('uuid',()=>out(crypto.randomUUID(),'ok'),'UUID v4');
add('pass.gen',(n=20)=>{const c='abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ23456789!@#$%^&*';
out(Array.from({length:+n},()=>c[rnd(0,c.length-1)]).join(''),'ok')},'генератор пароля');
add('pass.check',p=>{const s=p||'';let sc=0;if(s.length>11)sc+=2;if(/[a-z]/.test(s))sc++;if(/[A-Z]/.test(s))sc++;if(/\d/.test(s))sc++;if(/\W/.test(s))sc++;
out('оценка '+sc+'/6 → '+(sc>4?'сильный':sc>2?'средний':'слабый'),'info')},'проверка пароля');
add('jwt',()=>{const h=btoa('{"alg":"HS256","typ":"JWT"}'),b=btoa(JSON.stringify({sub:'root',iat:Date.now()/1000|0}));
out(h+'.'+b+'.'+Math.random().toString(36).slice(2,12),'dim')},'фейк-JWT');

/* --- ОЧИСТКА СЛЕДОВ (до 10 000) --- */
let wipes=0;
function scrubOnce(){
  try{localStorage.setItem('_s'+Math.random(),Math.random().toString(36));localStorage.removeItem('_s'+(Math.random()*1e6|0))}catch(_){}
  try{sessionStorage.setItem('_w',Math.random().toString(36))}catch(_){}
  try{document.cookie='_c=1;path=/;Max-Age=0'}catch(_){}
  try{history.replaceState({},'','#'+Math.random().toString(36).slice(2))}catch(_){}
  wipes++;
}
add('wipe.all',()=>{try{localStorage.clear();sessionStorage.clear();
document.cookie.split(';').forEach(c=>document.cookie=c.split('=')[0].trim()+'=;path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT');
term.innerHTML='';out('✔ storage/cookies/console очищены','ok')}catch(e){out(e.message,'err')}},'СЛЕДЫ: всё');
add('wipe.10000',async()=>{
  const total=10000;wipes=0;out('▶ очистка следов: 10 000 итераций','warn');
  const pb=bar(0);const cell=pb.firstChild;
  for(let i=0;i<total;i++){
    scrubOnce();
    if(i%250===0){cell.style.width=(i/total*100)+'%';await new Promise(r=>setTimeout(r))}
  }
  cell.style.width='100%';
  try{localStorage.clear();sessionStorage.clear();history.replaceState({},'','/')}catch(_){}
  out(`✔ выполнено ${wipes} операций очистки, счётчики и метки удалены`,'ok');
},'10 000 итераций');
add('wipe.console',()=>{term.innerHTML='';out('консоль очищена','ok')},'только консоль');
add('wipe.meta',()=>{try{history.replaceState({},'',location.pathname);out('URL-метка убрана','ok')}catch(_){out('нет доступа','err')}},'URL');
add('wipe.auto',()=>{clearInterval(window.__w);window.__w=setInterval(scrubOnce,4000);out('автоочистка каждые 4 с включена','warn')},'авто');
add('wipe.stop',()=>{clearInterval(window.__w);out('автоочистка остановлена','warn')},'стоп авто');

/* --- СИСТЕМА --- */
add('ua',()=>out(navigator.userAgent,'dim'),'User-Agent');
add('sys',()=>out(`cpu ${navigator.hardwareConcurrency} | ram ${navigator.deviceMemory||'?'}GB | ${innerWidth}x${innerHeight} | tz ${Intl.DateTimeFormat().resolvedOptions().timeZone} | ${navigator.platform}`,'info'),'данные устройства');
add('lang',()=>out(navigator.languages.join(', '),'dim'),'языки');
add('battery',async()=>{try{const b=await navigator.getBattery();out(`заряд ${(b.level*100)|0}% ${b.charging?'заряжается':''}`,'info')}catch(_){out('нет API','err')}},'батарея');
add('net',()=>{const c=navigator.connection;out(c?`${c.effectiveType} ${c.downlink}Mb/s rtt ${c.rtt}`:'нет API','info')},'сеть');

/* --- УТИЛИТЫ --- */
add('json',s=>{try{out(JSON.stringify(JSON.parse(s),null,1),'ok')}catch(e){out('не JSON','err')}},'формат JSON');
add('rnd',(a=1,b=100)=>out(rnd(+a,+b),'ok'),'случайное число');
add('dice',()=>out('🎲 '+(rnd(1,6)),'ok'),'кубик');
add('banner',()=>out(`<pre> ___  _  _ ___ ___\n| _ ) \\| |_ _/ __|\n| _ \\ . || | (__\n|___/_|_|___\\___|</pre>`,'ok'),'баннер');
add('cowsay',s=>out(`<pre> ${s||'hack the planet'}\n        \\   ^__^\n         \\  (oo)\\_______\n            (__)\\       )\\/\\\n                ||----w |\n                ||     ||</pre>`,'warn'),'корова');
add('joke',()=>out(['Программист ставит ловушки на баги.','Работает? Не трогай!','99 багов в коде — взял один, стало 127.'][rnd(0,2)],'dim'),'шутка');
add('report',()=>out(`VERSION 7.1.0\nFUNCS ${Object.keys(F).length}\nPROXY 400 (активен #${PROXIES[curProxy].id} ${PROXIES[curProxy].country})\nBRUTE ${brute.on} try=${brute.try}\nWIPES ${wipes}\nLIBS live=${live}`,'ok'),'отчёт');
add('log',()=>out('записей в консоли: '+term.children.length,'info'),'счёт лога');
add('export',()=>{const t=term.innerText;const a=document.createElement('a');
a.href=URL.createObjectURL(new Blob([t],{type:'text/plain'}));a.download='log.txt';a.click();out('лог скачан','ok')},'выгрузить лог');

/* --- ГЕНЕРИРУЕМЫЕ ФУНКЦИИ (набор до 340+) --- */
for(let i=1;i<=70;i++)add('proxy.p'+i,()=>{curProxy=i-1;out('→ '+PROXIES[i-1].ip+':'+PROXIES[i-1].port+' '+PROXIES[i-1].country,'ok');upd()},'прокси №'+i);
for(let i=1;i<=40;i++)add('scan.port'+i,()=>out(`порт ${[21,22,23,25,53,80,110,143,443,445,993,995,1433,1521,2049,3306,3389,5432,5900,6379,8080,8443,9000,9200,27017][i%25]} на цели ${brute.target||'—'}: ${Math.random()>.35?'OPEN':'filtered'}`,'dim'),'скан порта '+i);
for(let i=1;i<=40;i++)add('rule.'+i,()=>out(`правило #${i}: ${wl[i%wl.length]}+цифры+символ → мутация пароля`,'dim'),'правило '+i);
for(let i=1;i<=30;i++)add('dict.'+i,()=>{brute.passwords=brute.passwords.concat(wl.map(w=>w+i));out('в словарь добавлено '+wl.length+' вариантов (соль '+i+') → итого '+brute.passwords.length,'warn')},'расширить словарь '+i);
for(let i=1;i<=35;i++)add('hash.'+i,async s=>out(hex(await crypto.subtle.digest('SHA-256',new TextEncoder().encode((s||'seed')+i))),'dim'),'хеш #'+i);
for(let i=1;i<=30;i++)add('eth.w'+i,async()=>{await loadLibs();const m=bip39.generateMnemonic(128);
out(`[${i}] ${await deriveAddress(m,'')}`,'dim')},'кошелёк ETH '+i);
for(let i=1;i<=30;i++)add('keeper.r'+i,()=>out(`сценарий ${i}: ${wl[i%wl.length]} → пароль-vault, PBKDF2 100k`,'dim'),'сценарий keeper '+i);
for(let i=1;i<=25;i++)add('gen'+i,()=>out(Array.from({length:i+6},()=>wl[rnd(0,wl.length-1)]).join(' '),'dim'),'фраза из '+(i+6)+' слов');

/* ================= РЕНДЕР СПИСКА ================= */
const featsEl=document.getElementById('features'),cntEl=document.getElementById('cnt'),searchEl=document.getElementById('search');
let LIST=[];
function render(q=''){
  const keys=Object.keys(F).filter(k=>!q||k.includes(q.toLowerCase()));
  LIST=keys;cntEl.textContent=Object.keys(F).length;
  featsEl.innerHTML=keys.map(k=>`<div class="feat ${k.startsWith('brute')||k.startsWith('keeper')||k.startsWith('wipe')?'hot':''}" data-k="${k}">${k} <span class="dim">— ${D[k]||''}</span></div>`).join('');
}
featsEl.onclick=e=>{const d=e.target.closest('.feat');if(!d)return;cmdEl.value=d.dataset.k;cmdEl.focus()};
searchEl.oninput=()=>render(searchEl.value);

/* ================= ЗАПУСК ================= */
const cmdEl=document.getElementById('cmd');
const history_=[];let hi=-1;
async function run(raw){
  const line=raw.trim();if(!line)return;
  out('root@hack:~$ '+line,'dim');
  history_.push(line);hi=history_.length;
  const [c,...a]=line.split(/\s+/);const k=c.toLowerCase();
  if(F[k]){try{await F[k](...a)}catch(e){out('ERR: '+e.message,'err')}}
  else if(/^\d+$/.test(k)&&LIST[+k-1]){try{await F[LIST[+k-1]]()}catch(e){out('ERR: '+e.message,'err')}}
  else out('неизвестно: '+k+' — набери help','err');
}
cmdEl.onkeydown=async e=>{
  if(e.key==='Enter'){const v=cmdEl.value;cmdEl.value='';await run(v)}
  if(e.key==='ArrowUp'){if(hi>0)cmdEl.value=history_[--hi]}
  if(e.key==='ArrowDown'){if(hi<history_.length-1)cmdEl.value=history_[++hi];else cmdEl.value=''}
};
function upd(){const p=PROXIES[curProxy];statusEl.textContent=`#${p.id} ${p.country} ${p.ping}ms`;localStorage.setItem('proxy',curProxy)}
curProxy=+(localStorage.getItem('proxy')||0);upd();

render();
out('☠ HACKER CONSOLE 7.1.0','ok');
out('Функций: '+Object.keys(F).length+' | прокси: 400 | wipe: 10 000','warn');
out('help — список. Клик слева подставит команду.','info');
loadLibs();
</script>
