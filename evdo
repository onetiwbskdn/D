<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>HACKER CONSOLE v7.1.0</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{background:#000;color:#0f0;font-family:'Courier New',monospace;height:100vh;overflow:hidden}
#matrix{position:fixed;inset:0;z-index:0;opacity:.22}
#app{position:relative;z-index:2;display:flex;flex-direction:column;height:100vh;padding:8px}
header{border:1px solid #0f0;padding:6px 10px;display:flex;justify-content:space-between;align-items:center;background:rgba(0,20,0,.9)}
header h1{font-size:13px;letter-spacing:1px}
#status{font-size:10px;color:#0ff}
#main{flex:1;display:flex;gap:8px;margin-top:8px;min-height:0}
#sidebar{width:40%;display:flex;flex-direction:column;border:1px solid #0f0;background:rgba(0,15,0,.9);min-width:0}
#sidebar h2{font-size:11px;padding:5px 8px;border-bottom:1px solid #0f0}
#search{background:#000;color:#0f0;border:1px solid #0f0;margin:6px;padding:5px;font-family:inherit;font-size:11px;outline:none}
#features{flex:1;overflow-y:auto;padding:0 6px 6px}
